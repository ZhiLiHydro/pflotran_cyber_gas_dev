FROM pflotran/mpich4-gnu-opt:ubuntu22

ENV PETSC_DIR=/scratch/petsc PETSC_ARCH=petsc-arch
ARG PETSC_VERSION

WORKDIR /scratch
COPY ./.gitlab/build-petsc-opt.sh .
RUN /scratch/build-petsc-opt.sh

