ARG IMAGE
FROM $IMAGE
ENV PETSC_DIR=/scratch/petsc PETSC_ARCH=petsc-arch

WORKDIR /scratch/pflotran
COPY . .
WORKDIR /scratch/pflotran/src/pflotran
RUN make -j4 pflotran no_warnings=1
ENV PATH=$PATH:/scratch/pflotran/src/pflotran
ENV PFLOTRAN_DIR=/scratch/pflotran
WORKDIR /scratch

