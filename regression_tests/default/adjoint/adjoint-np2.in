#Description: 1D, 4 cells, no velocity: each cell is an independent batch
#             problem. For checking that results do not depend on the number
#             of MPI ranks. J = CO2(aq) at one cell.

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT_DAE
    /
  /
END

SUBSURFACE

REGRESSION
  CELL_IDS
    1
  /
END

NUMERICAL_METHODS TRANSPORT
  LINEAR_SOLVER
    SOLVER ITERATIVE      # DIRECT needs MUMPS in parallel
  /
END

GRID
  TYPE STRUCTURED
  NXYZ 4 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    4.d0 1.d0 1.d0
  /
END

REFERENCE_LIQUID_DENSITY 1000.d0

CHEMISTRY
  PRIMARY_SPECIES
    O2(aq)
    CH2O(aq)
    CO2(aq)
  /
  IMMOBILE_SPECIES
    Biomass
  /
  MICROBIAL_REACTION
    REACTION O2(aq) + CH2O(aq) <-> CO2(aq) + H2O
    RATE_CONSTANT 4.d-2
    MONOD
      SPECIES_NAME O2(aq)
      HALF_SATURATION_CONSTANT 2.d-4
    /
    MONOD
      SPECIES_NAME CH2O(aq)
      HALF_SATURATION_CONSTANT 1.25d-5
    /
    BIOMASS
      SPECIES_NAME Biomass
      YIELD 1.d-4
    /
  /
  IMMOBILE_DECAY_REACTION
    SPECIES_NAME Biomass
    RATE_CONSTANT 1.d-6
  /
  DATABASE ../../../shortcourse/exercises/0D_aerobic_respiration/aerobic_respiration.dat
  ACTIVITY_COEFFICIENTS OFF
  OUTPUT
    FREE_ION
    ALL
  /
END

MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 1.d0
END

REGION all
  COORDINATES
    -1.d20 -1.d20 -1.d20
    1.d20 1.d20 1.d20
  /
END

# cell 2 (natural id 2) sits at x in [1, 2], centroid 1.5
REGION cell2
  COORDINATE 1.5d0 0.5d0 0.5d0
END

OUTPUT
  TIME_UNITS d
END

TIME
  FINAL_TIME 5.d0 h
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 1.d0 h
END

TRANSPORT_CONDITION initial
  TYPE ZERO_GRADIENT
  CONSTRAINT initial
    CONCENTRATIONS
      O2(aq)    1.5d-3   F
      CH2O(aq)  2.d-3    F
      CO2(aq)   1.d-10   F
    /
    IMMOBILE
      Biomass   1.d-4
    /
  /
END

INITIAL_CONDITION
  TRANSPORT_CONDITION initial
  REGION all
END

STRATA
  REGION all
  MATERIAL soil1
END

ADJOINT
  COST_FUNCTION TERMINAL_SPECIES_CONCENTRATION
    SPECIES_NAME CO2(aq)
    REGION cell2
  /
  PARAMETER RATE_CONSTANT
    KINETICS MICROBIAL
    REACTION_INDEX 1
  /
END

END_SUBSURFACE
