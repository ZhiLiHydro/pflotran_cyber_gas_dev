#Description: Two costs in one adjoint run: CO2(aq) and O2(aq) at the single
#             cell. Expect dJ_1/dk > 0 and dJ_2/dk < 0 with similar magnitude
#             (1:1 stoichiometry).

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT_DAE
    /
  /
END

SUBSURFACE

NUMERICAL_METHODS TRANSPORT
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END

GRID
  TYPE STRUCTURED
  NXYZ 1 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    1.d0 1.d0 1.d0
  /
END

REFERENCE_LIQUID_DENSITY 1000.d0

CHEMISTRY
  PRIMARY_SPECIES
    O2(aq)
    CH2O(aq)
    CO2(aq)
  /
  IMMOBILE_SPECIES
    Biomass
  /
  MICROBIAL_REACTION
    REACTION O2(aq) + CH2O(aq) <-> CO2(aq) + H2O
    RATE_CONSTANT 4.d-2
    MONOD
      SPECIES_NAME O2(aq)
      HALF_SATURATION_CONSTANT 2.d-4
    /
    MONOD
      SPECIES_NAME CH2O(aq)
      HALF_SATURATION_CONSTANT 1.25d-5
    /
    BIOMASS
      SPECIES_NAME Biomass
      YIELD 1.d-4
    /
  /
  IMMOBILE_DECAY_REACTION
    SPECIES_NAME Biomass
    RATE_CONSTANT 1.d-6
  /
  DATABASE ../../../shortcourse/exercises/0D_aerobic_respiration/aerobic_respiration.dat
  ACTIVITY_COEFFICIENTS OFF
  OUTPUT
    FREE_ION
    ALL
  /
END

MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 1.d0
END

REGION all
  COORDINATES
    -1.d20 -1.d20 -1.d20
    1.d20 1.d20 1.d20
  /
END

REGION middle
  COORDINATE 0.5d0 0.5d0 0.5d0
END

OBSERVATION
  REGION middle
END

OUTPUT
  PERIODIC_OBSERVATION TIMESTEP 1
  TIME_UNITS d
END

TIME
  FINAL_TIME 1.d0 w
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 1.d0 h
END

TRANSPORT_CONDITION initial
  TYPE ZERO_GRADIENT
  CONSTRAINT initial
    CONCENTRATIONS
      O2(aq)    1.5d-3   F
      CH2O(aq)  2.d-3    F
      CO2(aq)   1.d-10   F
    /
    IMMOBILE
      Biomass   1.d-4
    /
  /
END

INITIAL_CONDITION
  TRANSPORT_CONDITION initial
  REGION all
END

STRATA
  REGION all
  MATERIAL soil1
END

#=========================== adjoint sensitivity ==============================
ADJOINT
  COST_FUNCTION TERMINAL_SPECIES_CONCENTRATION
    SPECIES_NAME CO2(aq)
    REGION middle
  /
  COST_FUNCTION TERMINAL_SPECIES_CONCENTRATION
    SPECIES_NAME O2(aq)
    REGION middle
  /
  PARAMETER RATE_CONSTANT
    KINETICS MICROBIAL
    REACTION_INDEX 1
  /
END

END_SUBSURFACE
