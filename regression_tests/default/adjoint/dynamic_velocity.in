#Description: ar_1d4_flux.in with a transient uniform velocity (1.d-4 m/s,
#             dropping to 2.d-5 m/s after 2 h). The backward sweep must
#             replay the velocities of each forcing segment. J = CO2(aq) at
#             cell 4.

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT_DAE
    /
  /
END

SUBSURFACE

NUMERICAL_METHODS TRANSPORT
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END

GRID
  TYPE STRUCTURED
  NXYZ 4 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    4.d0 1.d0 1.d0
  /
END

#=========================== specified velocity ===============================
SPECIFIED_VELOCITY
  UNIFORM? YES
  DATASET LIST
    TIME_UNITS h
    DATA_UNITS m/s m/s m/s
    INTERPOLATION STEP
    0.d0 1.d-4 0.d0 0.d0
    2.d0 2.d-5 0.d0 0.d0
  /
END

REFERENCE_LIQUID_DENSITY 1000.d0

CHEMISTRY
  PRIMARY_SPECIES
    O2(aq)
    CH2O(aq)
    CO2(aq)
  /
  IMMOBILE_SPECIES
    Biomass
  /
  MICROBIAL_REACTION
    REACTION O2(aq) + CH2O(aq) <-> CO2(aq) + H2O
    RATE_CONSTANT 4.d-2
    MONOD
      SPECIES_NAME O2(aq)
      HALF_SATURATION_CONSTANT 2.d-4
    /
    MONOD
      SPECIES_NAME CH2O(aq)
      HALF_SATURATION_CONSTANT 1.25d-5
    /
    BIOMASS
      SPECIES_NAME Biomass
      YIELD 1.d-4
    /
  /
  IMMOBILE_DECAY_REACTION
    SPECIES_NAME Biomass
    RATE_CONSTANT 1.d-6
  /
  DATABASE ../../../shortcourse/exercises/0D_aerobic_respiration/aerobic_respiration.dat
  ACTIVITY_COEFFICIENTS OFF
  OUTPUT
    FREE_ION
    ALL
  /
END

MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 1.d0
END

REGION all
  COORDINATES
    -1.d20 -1.d20 -1.d20
    1.d20 1.d20 1.d20
  /
END

REGION upstream
  COORDINATES
    0.d0 0.d0 0.d0
    2.d0 1.d0 1.d0
  /
END

REGION downstream
  COORDINATES
    2.d0 0.d0 0.d0
    4.d0 1.d0 1.d0
  /
END

REGION cell4
  COORDINATE 3.5d0 0.5d0 0.5d0
END

REGION inflow
  FACE WEST
  COORDINATES
    0.d0 0.d0 0.d0
    0.d0 1.d0 1.d0
  /
END

REGION outflow
  FACE EAST
  COORDINATES
    4.d0 0.d0 0.d0
    4.d0 1.d0 1.d0
  /
END

OUTPUT
  TIME_UNITS d
END

TIME
  FINAL_TIME 5.d0 h
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 1.d0 h
END

#=========================== transport conditions =============================
TRANSPORT_CONDITION rich
  TYPE ZERO_GRADIENT
  CONSTRAINT rich_c
    CONCENTRATIONS
      O2(aq)    1.5d-3   F
      CH2O(aq)  2.d-3    F
      CO2(aq)   1.d-10   F
    /
    IMMOBILE
      Biomass   1.d-4
    /
  /
END

TRANSPORT_CONDITION lean
  TYPE ZERO_GRADIENT
  CONSTRAINT lean_c
    CONCENTRATIONS
      O2(aq)    1.5d-5   F      # 100x lower than rich
      CH2O(aq)  2.d-3    F
      CO2(aq)   1.d-10   F
    /
    IMMOBILE
      Biomass   1.d-4
    /
  /
END

INITIAL_CONDITION ic_upstream
  TRANSPORT_CONDITION rich
  REGION upstream
END

INITIAL_CONDITION ic_downstream
  TRANSPORT_CONDITION lean
  REGION downstream
END

#=========================== condition couplers ===============================
BOUNDARY_CONDITION inflow
  TRANSPORT_CONDITION rich
  REGION inflow
END

BOUNDARY_CONDITION outflow
  TRANSPORT_CONDITION lean
  REGION outflow
END

STRATA
  REGION all
  MATERIAL soil1
END

ADJOINT
  COST_FUNCTION TERMINAL_SPECIES_CONCENTRATION
    SPECIES_NAME CO2(aq)
    REGION cell4
  /
  PARAMETER RATE_CONSTANT
    KINETICS MICROBIAL
    REACTION_INDEX 1
  /
END

END_SUBSURFACE
