#Description: Tests LIMIT_MINERAL_VOLUME_FRACTION RESIDUAL_POROSITY_FRACTION.
#  Two cells with different initial calcite inventories in supersaturated
#  water share one fraction of 0.99998, so each gates at its own threshold
#  computed from its initial porosity (1 - sumVF0). Cell 1 (VF 0.95,
#  porosity 0.05) gates at 0.049999 and must land at a volume fraction of
#  exactly 0.950001. Cell 2 (VF 0.90, porosity 0.10) gates at 0.099998 and
#  must land at exactly 0.900002.

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS TRANSPORT

  LINEAR_SOLVER
    SOLVER DIRECT
  /

END

#=========================== regression =======================================
REGRESSION
  CELL_IDS
    1
    2
  /
END

#=========================== flow =============================================
SPECIFIED_VELOCITY
  UNIFORM? YES
  DATASET 0.d0 0.d0 0.d0 m/yr
END

#=========================== chemistry ========================================
CHEMISTRY
  PRIMARY_SPECIES
    H+
    HCO3-
    Ca++
  /
  SECONDARY_SPECIES
    OH-
    CO3--
    CO2(aq)
    CaCO3(aq)
    CaHCO3+
    CaOH+
  /
  PASSIVE_GAS_SPECIES
    CO2(g)
  /
  MINERALS
    Calcite
  /
  MINERAL_KINETICS
    Calcite
      RATE_CONSTANT 1.d-6
      SURFACE_AREA_VOL_FRAC_POWER 1.d0
      SURFACE_AREA_FUNCTION VOLUME_FRACTION_RATIO
    /
  /
  DATABASE ../../../database/hanford.dat
  LOG_FORMULATION
  ACTIVITY_COEFFICIENTS TIMESTEP
  UPDATE_POROSITY
  MINIMUM_POROSITY 1.d-3
  LIMIT_MINERAL_VOLUME_FRACTION
    RESIDUAL_POROSITY_FRACTION 0.99998d0
  /
  OUTPUT
    PH
    TOTAL
    ALL
    MINERALS
  /
END

#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 1 1 2
  BOUNDS
    0.d0 0.d0 0.d0
    1.d0 1.d0 2.d0
  /
END

#=========================== fluid properties =================================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 5.d-2
  TORTUOSITY 1.d0
END

MATERIAL_PROPERTY soil2
  ID 2
  POROSITY 1.d-1
  TORTUOSITY 1.d0
END

#=========================== output options ===================================
OUTPUT
  PERIODIC_OBSERVATION TIMESTEP 1
  FORMAT TECPLOT POINT
  PRINT_COLUMN_IDS
END

#=========================== times ============================================
TIME
  FINAL_TIME 1.d0 y
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 1.d-1 y
END

#=========================== regions ==========================================
REGION bottom
  COORDINATES
    0.d0 0.d0 0.d0
    1.d0 1.d0 1.d0
  /
END

REGION top
  COORDINATES
    0.d0 0.d0 1.d0
    1.d0 1.d0 2.d0
  /
END

#=========================== transport conditions =============================
TRANSPORT_CONDITION initial_dense
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial_dense
  /
END

TRANSPORT_CONDITION initial_loose
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial_loose
  /
END

#=========================== constraints ======================================
CONSTRAINT initial_dense
  CONCENTRATIONS
    H+     1.d-8      F
    HCO3-  1.d-3      G  CO2(g)
    Ca++   1.d-1      T
  /
  MINERALS
    Calcite  0.95d0 1.d2 m^2/m^3
  /
END

CONSTRAINT initial_loose
  CONCENTRATIONS
    H+     1.d-8      F
    HCO3-  1.d-3      G  CO2(g)
    Ca++   1.d-1      T
  /
  MINERALS
    Calcite  0.9d0 1.d2 m^2/m^3
  /
END

#=========================== condition couplers ===============================
# initial conditions
INITIAL_CONDITION
  TRANSPORT_CONDITION initial_dense
  REGION bottom
END

INITIAL_CONDITION
  TRANSPORT_CONDITION initial_loose
  REGION top
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION bottom
  MATERIAL soil1
END

STRATA
  REGION top
  MATERIAL soil2
END

END_SUBSURFACE
