SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
  /
END

SUBSURFACE
  GRID
    TYPE UNSTRUCTURED_EXPLICIT ./one_tet_tetgen
    EXPLICIT_GRID_SOURCE PRIMAL_VORONOI
    PRIMAL_MESH_FORMAT TETGEN
    CONTROL_VOLUME_TYPE VORONOI
  END

  MATERIAL_PROPERTY soil1
    ID 1
    POROSITY 0.25d0
    CHARACTERISTIC_CURVES default
    PERMEABILITY
      PERM_ISO 1.d-12
    /
  END

  CHARACTERISTIC_CURVES default
    DEFAULT
  END

  REGION all
    COORDINATES
      -1.d0 -1.d0 -1.d0
      2.d0 2.d0 2.d0
    /
  END

  FLOW_CONDITION initial
    TYPE
      LIQUID_PRESSURE HYDROSTATIC
    /
    DATUM 0.d0 0.d0 1.d0
    LIQUID_PRESSURE 101325.d0
  END

  INITIAL_CONDITION
    FLOW_CONDITION initial
    REGION all
  END

  STRATA
    REGION all
    MATERIAL soil1
  END

  TIME
    FINAL_TIME 1.d0 s
    INITIAL_TIMESTEP_SIZE 1.d0 s
    MAXIMUM_TIMESTEP_SIZE 1.d0 s
  END

  NUMERICAL_METHODS FLOW
    TIMESTEPPER
      MAX_STEPS 1
    /
  END

  OUTPUT
    SNAPSHOT_FILE
      PERIODIC TIME 1.d0 s
    /
    SCREEN PERIODIC 1
  END
END_SUBSURFACE
