#Description: Richards flow on two layers of two pentagonal prisms read from
#             the HDF5 polyhedra (XDMF-code) schema. Cells share pentagonal
#             faces between layers and quadrilateral faces within a layer.
#             Mesh generated by generate_polyhedra_h5_grid.py. Each prism
#             has volume (1 - 0.3^2/2)*0.5 = 0.4775 m^3. A pressure
#             boundary condition is applied on the two top pentagons,
#             face set "top_vertices" read as variable-length vertex lists
#             (FaceVertexIDs and FaceOffsets) from the mesh.

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
  /
END

SUBSURFACE

#=========================== regression =======================================
REGRESSION
  CELL_IDS
    1
    2
    3
    4
  /
END

#=========================== discretization ===================================
GRID
  TYPE UNSTRUCTURED_POLYHEDRA ./pentagonal_prisms.h5
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 0.25d0
  TORTUOSITY 0.5d0
  SATURATION_FUNCTION sf1
  PERMEABILITY
    PERM_ISO 1.d-12
  /
END

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES sf1
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.286
    ALPHA  1.9401d-4
    LIQUID_RESIDUAL_SATURATION 0.115
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.286
    LIQUID_RESIDUAL_SATURATION 0.115
  /
END

#=========================== output options ===================================
OUTPUT
  VARIABLES
    LIQUID_PRESSURE
    LIQUID_SATURATION
    VOLUME
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 1.d0 d
  MAXIMUM_TIMESTEP_SIZE 0.1d0 d
END

REFERENCE_PRESSURE 101325.

#=========================== regions ==========================================
REGION all
  COORDINATES
    -1.d0 -1.d0 -1.d0
    3.d0 2.d0 2.d0
  /
END

! cell centroids: x ~0.45 (left) or ~1.55 (right), z = 0.25 or 0.75
REGION bottom_left
  COORDINATES
    -1.d0 -1.d0 0.d0
    1.d0 2.d0 0.5d0
  /
END

REGION top_right
  COORDINATES
    1.d0 -1.d0 0.5d0
    3.d0 2.d0 1.d0
  /
END

REGION top_vertices
  FILE ./pentagonal_prisms.h5
END

#=========================== flow conditions ==================================
! unequal initial pressures drive flow across pentagonal (between layers)
! and quadrilateral (within a layer) faces
FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 101325.d0
END

FLOW_CONDITION high
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 201325.d0
END

FLOW_CONDITION low
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 51325.d0
END

FLOW_CONDITION top
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 151325.d0
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial
  REGION all
END

INITIAL_CONDITION
  FLOW_CONDITION high
  REGION bottom_left
END

INITIAL_CONDITION
  FLOW_CONDITION low
  REGION top_right
END

BOUNDARY_CONDITION top
  FLOW_CONDITION top
  REGION top_vertices
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION all
  MATERIAL soil1
END
END_SUBSURFACE
