#Description: Radioactive decay of a parent that is mostly sorbed by
#             equilibrium surface complexation: the sorbed inventory decays
#             too, as in MODE GIRT (MODE GIRT_DAE)

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT_DAE
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS TRANSPORT
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END

#=========================== regression =======================================
REGRESSION
  CELL_IDS
    1
    5
    10
  /
END

SPECIFIED_VELOCITY
  UNIFORM? YES
  DATASET 0.d0 0.d0 0.d0 m/yr
END

#=========================== chemistry ========================================
# At pH 9 the sorbed H+ (>FeOH2+_w - >FeO-_w - >FeOHZn+_w) is negative and
# dominates, so the H+ component inventory is negative
CHEMISTRY
  PRIMARY_SPECIES
    H+
    Na+
    NO3-
    Zn++
  /
  RADIOACTIVE_DECAY_REACTION
    REACTION Zn++ <-> Na+
    RATE_CONSTANT 5.d-8
  /
  SORPTION
    SURFACE_COMPLEXATION_RXN
      EQUILIBRIUM
      SITE >FeOH_w 7.6355e4
      COMPLEXES
        >FeOH2+_w
        >FeO-_w
        >FeOHZn+_w
      /
    /
  /
  DATABASE ../../ascem/batch/surface-complexation.dat
  LOG_FORMULATION
  OUTPUT
    ALL
    PH
    TOTAL
    TOTAL_SORBED
  /
END

#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 10 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

#=========================== fluid properties =================================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 0.9d0
  TORTUOSITY 1.d0
END

#=========================== times ============================================
TIME
  FINAL_TIME 1.d0 y
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 1.d-2 y
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

REGION west
  FACE WEST
  COORDINATES
    0.d0 0.d0 0.d0
    0.d0 1.d0 1.d0
  /
END

REGION east
  FACE EAST
  COORDINATES
    10.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

#=========================== transport conditions =============================
TRANSPORT_CONDITION initial
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial
  /
END

TRANSPORT_CONDITION inlet
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 inlet
  /
END

#=========================== transport constraints ============================
CONSTRAINT initial
  CONCENTRATIONS
    H+     9.0     P
    Na+    1.0e-5  Z
    NO3-   1.0e-1  T
    Zn++   1.0e-7  T
  /
END

CONSTRAINT inlet
  CONCENTRATIONS
    H+     1.0e-5  T
    Na+    1.0e-5  Z
    NO3-   1.0e-1  T
    Zn++   1.0e-7  T
  /
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  TRANSPORT_CONDITION initial
  REGION all
END

BOUNDARY_CONDITION outlet
  TRANSPORT_CONDITION initial
  REGION east
END

BOUNDARY_CONDITION inlet
  TRANSPORT_CONDITION inlet
  REGION west
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION all
  MATERIAL soil1
END

END_SUBSURFACE
