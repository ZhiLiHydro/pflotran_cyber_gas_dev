#Description: 0D Monod degradation of a vanishing substrate, LOG_FORMULATION (MODE GIRT_DAE)

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT_DAE
    /
  /
END

SUBSURFACE

NUMERICAL_METHODS TRANSPORT
  TIMESTEPPER
  /
  NEWTON_SOLVER
    ATOL 1.d-12
  /
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END

REGRESSION
  CELL_IDS
    1
  /
END

SPECIFIED_VELOCITY
  UNIFORM? YES
  DATASET 0.d0 0.d0 0.d0
END

CHEMISTRY
  LOG_FORMULATION
  PRIMARY_SPECIES
    A(aq)
    B(aq)
  /
  MICROBIAL_REACTION
    REACTION A(aq) <-> B(aq)
    RATE_CONSTANT 1.d-8
    MONOD
      SPECIES_NAME A(aq)
      HALF_SATURATION_CONSTANT 1.d-5
    /
    CONCENTRATION_UNITS ACTIVITY
  /
  ACTIVITY_COEFFICIENTS OFF
  OUTPUT
    ALL
    TOTAL
  /
END

GRID
  TYPE STRUCTURED
  NXYZ 1 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    1.d0 1.d0 1.d0
  /
END

FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END

MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 0.25d0
  TORTUOSITY 1.d0
END

OUTPUT
  TIMES h 3. 6. 9.
END

TIME
  FINAL_TIME 12.d0 h
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 6.d0 h
END

REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    1.d0 1.d0 1.d0
  /
END

TRANSPORT_CONDITION initial
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial
  /
END

CONSTRAINT initial
  CONCENTRATIONS
    A(aq) 1.d-4 T
    B(aq) 1.d-7 T
  /
END

INITIAL_CONDITION
  TRANSPORT_CONDITION initial
  REGION all
END

STRATA
  REGION all
  MATERIAL soil1
END

END_SUBSURFACE
