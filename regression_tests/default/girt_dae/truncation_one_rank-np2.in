#Description: two cells on two processes, the second inactive; a fast decay
#truncates Newton updates on the first process only (MODE GIRT_DAE)

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT_DAE
    /
  /
END

SUBSURFACE

REGRESSION
  CELL_IDS
    1
  /
END

CHEMISTRY
  PRIMARY_SPECIES
    Tracer1
    Tracer2
  /
  RADIOACTIVE_DECAY_REACTION
    REACTION Tracer1 <-> Tracer2
    RATE_CONSTANT 1.d8
  /
  DATABASE ../../../database/hanford.dat
  OUTPUT
    ALL
    TOTAL
  /
END

GRID
  TYPE STRUCTURED
  NXYZ 2 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    2.d0 1.d0 1.d0
  /
END

FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END

MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 0.25d0
  TORTUOSITY 1.d0
END

TIME
  FINAL_TIME 1.d-1 d
  INITIAL_TIMESTEP_SIZE 1.d-1 d
  MAXIMUM_TIMESTEP_SIZE 1.d-1 d
END

REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    2.d0 1.d0 1.d0
  /
END

REGION second
  COORDINATES
    1.d0 0.d0 0.d0
    2.d0 1.d0 1.d0
  /
END

TRANSPORT_CONDITION initial
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial
  /
END

CONSTRAINT initial
  CONCENTRATIONS
    Tracer1 1.d-3 T
    Tracer2 1.d-7 T
  /
END

INITIAL_CONDITION
  TRANSPORT_CONDITION initial
  REGION all
END

STRATA
  REGION all
  MATERIAL soil1
END

STRATA
  REGION second
  MATERIAL soil1
  INACTIVE
END

END_SUBSURFACE
