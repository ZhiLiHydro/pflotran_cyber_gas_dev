#Description: 1D column where Monod consumption drives A(aq) to zero
#downstream of the inlet (LOG_FORMULATION, MODE GIRT_DAE): ln(c) of the
#vanishing species must follow its inventory down to a floor, not underflow
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT_DAE
    /
  /
END
SUBSURFACE
NUMERICAL_METHODS TRANSPORT
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END
REGRESSION
  CELL_IDS
    1
    5
    10
    25
    50
  /
END
SPECIFIED_VELOCITY
  UNIFORM? YES
  DATASET 1.d0 0.d0 0.d0 m/d
END
CHEMISTRY
  PRIMARY_SPECIES
    A(aq)
    B(aq)
  /
  MICROBIAL_REACTION
    REACTION A(aq) <-> B(aq)
    RATE_CONSTANT 3.d-9
    MONOD
      SPECIES_NAME A(aq)
      HALF_SATURATION_CONSTANT 1.d-9
    /
    CONCENTRATION_UNITS ACTIVITY
  /
  ACTIVITY_COEFFICIENTS OFF
  LOG_FORMULATION
  OUTPUT
    B(aq)
    TOTAL
  /
END
GRID
  TYPE STRUCTURED
  NXYZ 50 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END
MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 0.25d0
  TORTUOSITY 1.d0
END
TIME
  FINAL_TIME 0.5d0 d
  INITIAL_TIMESTEP_SIZE 1.d-2 d
  MAXIMUM_TIMESTEP_SIZE 5.d-1 d
END
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END
REGION west
  FACE WEST
  COORDINATES
    0.d0 0.d0 0.d0
    0.d0 1.d0 1.d0
  /
END
REGION east
  FACE EAST
  COORDINATES
    10.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END
TRANSPORT_CONDITION initial
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial
  /
END
TRANSPORT_CONDITION inlet
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 inlet
  /
END
CONSTRAINT initial
  CONCENTRATIONS
    A(aq) 1.d-4 T
    B(aq) 1.d-7 T
  /
END
CONSTRAINT inlet
  CONCENTRATIONS
    A(aq) 1.d-4 T
    B(aq) 1.d-7 T
  /
END
INITIAL_CONDITION
  TRANSPORT_CONDITION initial
  REGION all
END
BOUNDARY_CONDITION outlet
  TRANSPORT_CONDITION initial
  REGION east
END
BOUNDARY_CONDITION inlet
  TRANSPORT_CONDITION inlet
  REGION west
END
STRATA
  REGION all
  MATERIAL soil1
END
END_SUBSURFACE
