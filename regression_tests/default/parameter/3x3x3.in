SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
  /
END

SUBSURFACE

#=========================== regression =======================================
REGRESSION
  CELLS_PER_PROCESS 2
  CELL_IDS
    14
  /
END

EXTERNAL_FILE common_datasets.txt

#=========================== parameters =======================================
! SCALAR is intentionally uniform; cell_indexed and gridded vary in space.
PARAMETER
  NAME scalar
  SCALAR 86.
END

PARAMETER
  NAME cell_indexed
  DATASET Distance_cell_indexed
END

PARAMETER
  NAME gridded
  DATASET Distance_gridded
END

#=========================== output options ===================================
OUTPUT
  VARIABLES
    LIQUID_PRESSURE
    PARAMETER scalar
    PARAMETER cell_indexed
    PARAMETER gridded
  /
END

EXTERNAL_FILE common_domain.txt

END_SUBSURFACE
