#Description: cell-indexed DATASET is static even with AFTER_STEP FLOW re-apply
# Facet T6: documents non-evolving cell-indexed path (one-shot HDF5 read).
# Multi-step run; PARAMETER must match static Porosity_cell_indexed field.
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
  /
END

SUBSURFACE

REGRESSION
  VARIABLES
    POROSITY
    MINERAL_POROSITY
    PARAMETER phi_static
  /
  CELL_IDS
    1
    14
    27
  /
END

EXTERNAL_FILE common_datasets.txt

PARAMETER
  NAME phi_static
  DATASET Porosity_cell_indexed
  TARGET_VARIABLE POROSITY
  WHEN_TO_UPDATE AFTER_STEP FLOW
END

OUTPUT
  VARIABLES
    POROSITY
    MINERAL_POROSITY
    PARAMETER phi_static
  /
END

EXTERNAL_FILE common_domain_body.txt

! Two flow steps so AFTER_STEP FLOW runs more than once; cell-indexed values
! must remain the static field (same as target_porosity at t=0).
TIME
  FINAL_TIME 2.d0 s
  INITIAL_TIMESTEP_SIZE 1.d0 s
  MAXIMUM_TIMESTEP_SIZE 1.d0 s
END

END_SUBSURFACE
