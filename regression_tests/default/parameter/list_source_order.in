#Description: SOURCE after TARGET in the same AFTER_STEP slot despite
# reversed card order. phi_snap is listed first but sources POROSITY
# written by phi_list; update order must apply phi_list first.
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
  /
END

SUBSURFACE

REGRESSION
  VARIABLES
    POROSITY
    MINERAL_POROSITY
    PARAMETER phi_snap
    PARAMETER phi_list
  /
  CELL_IDS
    14
  /
END

PARAMETER
  NAME phi_snap
  SOURCE_VARIABLE POROSITY
  WHEN_TO_UPDATE AFTER_STEP FLOW
END

PARAMETER
  NAME phi_list
  LIST
    TIME_UNITS s
    INTERPOLATION LINEAR
    0.d0  0.12d0
    1.d0  0.18d0
  /
  TARGET_VARIABLE POROSITY
  WHEN_TO_UPDATE AFTER_STEP FLOW
END

OUTPUT
  VARIABLES
    POROSITY
    MINERAL_POROSITY
    PARAMETER phi_snap
    PARAMETER phi_list
  /
END

EXTERNAL_FILE common_domain.txt

END_SUBSURFACE
