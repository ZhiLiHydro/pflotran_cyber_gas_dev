#Description: LIST STEP interpolation holds plateau until next time node
# Facet T2: INTERPOLATION STEP; FINAL_TIME 0.5 s with nodes at 0 and 1 s.
# STEP at t=0.5 remains at first value (0.12); LINEAR would average to 0.18.
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
  /
END

SUBSURFACE

REGRESSION
  VARIABLES
    POROSITY
    MINERAL_POROSITY
    PARAMETER phi_step
  /
  CELL_IDS
    14
  /
END

PARAMETER
  NAME phi_step
  LIST
    TIME_UNITS s
    INTERPOLATION STEP
    0.d0  0.12d0
    1.d0  0.24d0
  /
  TARGET_VARIABLE POROSITY
  WHEN_TO_UPDATE AFTER_STEP FLOW
END

OUTPUT
  VARIABLES
    POROSITY
    MINERAL_POROSITY
    PARAMETER phi_step
  /
END

EXTERNAL_FILE common_domain_body.txt

TIME
  FINAL_TIME 0.5d0 s
  INITIAL_TIMESTEP_SIZE 0.5d0 s
  MAXIMUM_TIMESTEP_SIZE 0.5d0 s
END

END_SUBSURFACE
