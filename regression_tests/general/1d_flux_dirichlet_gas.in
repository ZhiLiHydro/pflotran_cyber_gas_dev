#Description:

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE GENERAL
      OPTIONS
      /
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW

  TIMESTEPPER
    #  MAX_STEPS -1
    SATURATION_CHANGE_GOVERNOR 1.d0
    CONCENTRATION_CHANGE_GOVERNOR 0.5d0
    CFL_GOVERNOR 1.
  /

  NEWTON_SOLVER
    USE_EUCLIDEAN_NORM_CONVERGENCE
    MAXIMUM_NUMBER_OF_ITERATIONS 50
    RTOL 1.d-8
    ATOL 1.d-8
    STOL 1.d-30
  /

  LINEAR_SOLVER
    SOLVER DIRECT
  /

END

#=========================== regression =======================================
REGRESSION
  CELL_IDS
    1
    2
  /
END

#=========================== flow mode ========================================

#=========================== debug settings ===================================
#USE_TOUCH_OPTIONS

#DEBUG
#MATVIEW_JACOBIAN
#VECVIEW_RESIDUAL
#VECVIEW_SOLUTION
#/

#=========================== time stepper options =============================

#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 1 1 10
  BOUNDS
    0.d0 0.d0 0.d0
    1.d0 1.d0 1.d1
  /
/

#=========================== solver options ===================================


#=========================== fluid properties =================================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
/

#=========================== material properties ==============================
MATERIAL_PROPERTY soil
  ID 1
  CHARACTERISTIC_CURVES cc1
  POROSITY 0.25
  TORTUOSITY 0.5
  ROCK_DENSITY 2650.d-3 kg/L
  THERMAL_CONDUCTIVITY_DRY 0.5d-6 MW/m-C
  THERMAL_CONDUCTIVITY_WET 2.d-6 MW/m-C
  HEAT_CAPACITY 830.d-6 MJ/kg-C
  PERMEABILITY
    PERM_X 1.d-18
    PERM_Y 1.d-18
    PERM_Z 1.d-18
  /
/

#=========================== saturation functions =============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    LIQUID_RESIDUAL_SATURATION 0.2d0
    ALPHA 1.d-4
    M 0.5d0
    MAX_CAPILLARY_PRESSURE 1.d6
  /
  PERMEABILITY_FUNCTION MUALEM
    PHASE LIQUID
    LIQUID_RESIDUAL_SATURATION 0.2d0
    M 0.5d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_GAS
    PHASE GAS
    LIQUID_RESIDUAL_SATURATION 0.2d0
    GAS_RESIDUAL_SATURATION 0.1d0
    M 0.5d0
  /
/

#=========================== output options ===================================
OUTPUT
  PERIODIC TIME 0.1 y
  PERIODIC_OBSERVATION TIMESTEP 1
#  FORMAT TECPLOT POINT
  FORMAT HDF5
  VELOCITY_AT_CENTER
  MASS_BALANCE
  VARIABLES
     LIQUID_PRESSURE
     GAS_PRESSURE
     LIQUID_SATURATION
     GAS_SATURATION
     LIQUID_MOBILITY
     GAS_MOBILITY
  /
/

#=========================== times ============================================
TIME
  FINAL_TIME 2. y
  INITIAL_TIMESTEP_SIZE 1.d0 s
  MAXIMUM_TIMESTEP_SIZE 0.1d0 y
/

#=========================== regions ==========================================
REGION all
  COORDINATES
    -1.d20 -1.d20 -1.d20
    1.d20 1.d20 1.d20
  /
/

REGION top
  FACE top
  COORDINATES
    0.D0 0.D0 10.D0
    1.D0 1.D0 10.D0
  /
/

REGION bottom
  FACE bottom
  COORDINATES
    0.D0 0.D0 0.D0
    1.D0 1.D0 0.D0
  /
/

#=========================== observation points ===============================


#=========================== flow conditions ==================================
FLOW_CONDITION initial
  TYPE
    GAS_PRESSURE DIRICHLET
    GAS_SATURATION DIRICHLET
    TEMPERATURE DIRICHLET
  /
  GAS_PRESSURE 111325.d0
  GAS_SATURATION 0.5D0
  TEMPERATURE 25.d0
/

FLOW_CONDITION top
  TYPE
    LIQUID_FLUX NEUMANN
    GAS_PRESSURE DIRICHLET
    TEMPERATURE DIRICHLET
  /
  LIQUID_FLUX 1.D-1 m/y
  GAS_PRESSURE 111325D0
  TEMPERATURE 25.D0
/

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial
  REGION all
/

BOUNDARY_CONDITION top
  FLOW_CONDITION top
  REGION top
/

#=========================== stratigraphy couplers ============================
STRATA
  MATERIAL soil
  REGION all
/

END_SUBSURFACE
