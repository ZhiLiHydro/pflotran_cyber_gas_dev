# Four-cell liquid Robin regression on two MPI ranks.
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE GENERAL
      OPTIONS
        ISOTHERMAL
      /
    /
  /
END
SUBSURFACE

REGRESSION
  CELL_IDS
    1
    4
  /
END

GRID
  TYPE STRUCTURED
  NXYZ 4 1 1
  BOUNDS
    0 0 0
    1 1 1
  /
  GRAVITY 0 0 0
END
FLUID_PROPERTY
  PHASE LIQUID
  DIFFUSION_COEFFICIENT 1e-9
END
FLUID_PROPERTY
  PHASE GAS
  DIFFUSION_COEFFICIENT 2e-5
END
MATERIAL_PROPERTY rock
  ID 1
  POROSITY 0.25
  TORTUOSITY 1
  ROCK_DENSITY 2700
  THERMAL_CONDUCTIVITY_DRY 1
  THERMAL_CONDUCTIVITY_WET 1
  HEAT_CAPACITY 835
  PERMEABILITY
    PERM_ISO 1e-12
  /
  CHARACTERISTIC_CURVES rock
END
CHARACTERISTIC_CURVES rock
  SATURATION_FUNCTION VAN_GENUCHTEN
    LIQUID_RESIDUAL_SATURATION 0
    ALPHA 1e-4
    M 0.5
  /
  PERMEABILITY_FUNCTION MUALEM
    PHASE LIQUID
    LIQUID_RESIDUAL_SATURATION 0
    M 0.5
  /
  PERMEABILITY_FUNCTION MUALEM_VG_GAS
    PHASE GAS
    LIQUID_RESIDUAL_SATURATION 0
    GAS_RESIDUAL_SATURATION 0
    M 0.5
  /
END
NUMERICAL_METHODS FLOW
  NEWTON_SOLVER
    ANALYTICAL_JACOBIAN
    ATOL 1e-14
    RTOL 1e-10
    STOL 1e-30
    MINIMUM_NEWTON_ITERATIONS 2
    MAXIMUM_NUMBER_OF_ITERATIONS 30
  /
END
TIME
  FINAL_TIME 10 s
  INITIAL_TIMESTEP_SIZE 0.01 s
  MAXIMUM_TIMESTEP_SIZE 1 s
END
OUTPUT
  ASCII_DIGITS_OF_PRECISION 15
  FORMAT HDF5
  TIMES s 0.1 1 10
  VARIABLES
    LIQUID_PRESSURE
    GAS_PRESSURE
    LIQUID_SATURATION
    GAS_SATURATION
    LIQUID_DENSITY
    GAS_DENSITY
    LIQUID_DENSITY_MOLAR
    GAS_DENSITY_MOLAR
    LIQUID_MOLE_FRACTIONS
    GAS_MOLE_FRACTIONS
    LIQUID_VISCOSITY
    TEMPERATURE
    THERMODYNAMIC_STATE
  /
  MASS_BALANCE_FILE
    PERIODIC TIMESTEP 1
  /
END
REGION all
  INFINITE
END
REGION inlet
  FACE WEST
  COORDINATES
    0 0 0
    0 1 1
  /
END
REGION outlet
  FACE EAST
  COORDINATES
    1 0 0
    1 1 1
  /
END
FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE DIRICHLET
    MOLE_FRACTION DIRICHLET
    TEMPERATURE DIRICHLET
  /
  LIQUID_PRESSURE 200000
  MOLE_FRACTION 0
  TEMPERATURE 12
END
FLOW_CONDITION inlet
  TYPE
    LIQUID_PRESSURE DIRICHLET
    MOLE_FRACTION DIRICHLET
    TEMPERATURE DIRICHLET
  /
  LIQUID_PRESSURE 200100.0
  MOLE_FRACTION 0
  TEMPERATURE 12
  LIQUID_ROBIN_COEFFICIENT 1e-10
END
FLOW_CONDITION outlet
  TYPE
    LIQUID_PRESSURE DIRICHLET
    MOLE_FRACTION DIRICHLET
    TEMPERATURE DIRICHLET
  /
  LIQUID_PRESSURE 200000
  MOLE_FRACTION 0
  TEMPERATURE 12
END
INITIAL_CONDITION
  FLOW_CONDITION initial
  REGION all
END
STRATA
  REGION all
  MATERIAL rock
END
BOUNDARY_CONDITION inlet
  FLOW_CONDITION inlet
  REGION inlet
END
BOUNDARY_CONDITION outlet
  FLOW_CONDITION outlet
  REGION outlet
END
END_SUBSURFACE
