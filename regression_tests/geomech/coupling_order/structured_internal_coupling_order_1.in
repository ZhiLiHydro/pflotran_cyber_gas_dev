SIMULATION
  SIMULATION_TYPE GEOMECHANICS_SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE richards
    /
    GEOMECHANICS_SUBSURFACE geomech
      OPTIONS
        FLOW_COUPLING ONE_WAY_COUPLED
      /
    /
  /
END

EXTERNAL_FILE subsurface_common.txt

GEOMECHANICS

EXTERNAL_FILE geomechanics_common.txt

GEOMECHANICS_FLOW_INTERPOLATION
  ORDER 1
/

GEOMECHANICS_MATERIAL_PROPERTY soil1
  ID 1
  ROCK_DENSITY 1.0
  YOUNGS_MODULUS 1000.0
  POISSONS_RATIO 0.0
  BIOT_COEFFICIENT 0.0
  THERMAL_EXPANSION_COEFFICIENT 0.0
END

END_GEOMECHANICS
