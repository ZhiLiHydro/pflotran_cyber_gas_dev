# jaa: this mimics the case from verification manuscript for mandel bc
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS 
        OPTIONS
          DISABLE_CAPILLARITY
      /
    / 
    SUBSURFACE_GEOMECHANICS geomech
      OPTIONS
        FLOW_COUPLING TWO_WAY_COUPLED
        SPLIT_SCHEME FIXED_STRESS
      /
    /
  / 
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW

  TIMESTEPPER
    MAX_TS_CUTS 200
  /

  NEWTON_SOLVER
    RTOL 1.000d-012
    STOL 1.000d-30
    ITOL 1.000d-09
    ITOL_UPDATE 0.0001
  /

  LINEAR_SOLVER
    SOLVER DIRECT
  /

END

EOS WATER
  DENSITY CONSTANT 1000.0 #[kg/m^3]
  VISCOSITY CONSTANT 0.001 #[Pa-s]
END

GRID
  TYPE STRUCTURED
  BOUNDS
    0.0 0.0 0.0 
    1.d0 1.d0 1.d0 
  /
  NXYZ 3 3 3
  GRAVITY 0.0 0.0 0.0 
END


TIME
  FINAL_TIME 1.d-1 s
  INITIAL_TIMESTEP_SIZE 1.d-3 s
  MAXIMUM_TIMESTEP_SIZE 1.d-2 s
END

MATERIAL_PROPERTY soil1
  ID 1
  CHARACTERISTIC_CURVES default
  POROSITY 0.375
  TORTUOSITY 1.0
  ROCK_DENSITY 1.d0
  PERMEABILITY
    PERM_ISO 1.000d-12
  /
  GEOMECHANICS_SUBSURFACE_PROPS
    COMPRESSIBILITY_FUNCTION LINEAR_MODEL
  /
END

CHARACTERISTIC_CURVES default
  SATURATION_FUNCTION VAN_GENUCHTEN
   ALPHA 0.0001
   M 0.5
   LIQUID_RESIDUAL_SATURATION 0.1
  / 
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
   M 0.5
   LIQUID_RESIDUAL_SATURATION 0.1
  / 
END

REGION all
  COORDINATES
    0.0 0.0 0.0 
    1.0 1.0 1.0 
  /
END

REGION top
  FACE TOP
  COORDINATES
    0.0 0.0 1.0 
    1.0 1.0 1.0 
  /
END

FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 201325.d0
END

FLOW_CONDITION top_flow
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 201325.d0
END

INITIAL_CONDITION initial
  FLOW_CONDITION initial
  REGION all
END

BOUNDARY_CONDITION top
  FLOW_CONDITION top_flow
  REGION top
END

STRATA
  REGION all
  MATERIAL soil1
END

REGRESSION
  CELL_IDS
    2
    11
    20
  /
  VARIABLES
    LIQUID_PRESSURE
  /
END

END_SUBSURFACE

GEOMECHANICS

GEOMECHANICS_GRID
  TYPE UNSTRUCTURED ../meshes/structured_3x3x3/usg.mesh
  GRAVITY 0.0 0.0 0.0 
END

GEOMECHANICS_LINEAR_SOLVER
  SOLVER DIRECT
END

GEOMECHANICS_MAPPING_FILE ../meshes/structured_3x3x3/flow_geomech_mapping.dat

GEOMECHANICS_REGION all_geomech
  FILE ../meshes/structured_3x3x3/all.vset
END

GEOMECHANICS_REGION north_geomech
  FILE ../meshes/structured_3x3x3/north.ss
END

GEOMECHANICS_REGION south_geomech
  FILE ../meshes/structured_3x3x3/south.vset
END

GEOMECHANICS_REGION west_geomech
  FILE ../meshes/structured_3x3x3/west.vset
END

GEOMECHANICS_REGION east_geomech
  FILE ../meshes/structured_3x3x3/east.vset
END

GEOMECHANICS_REGION bottom_geomech
  FILE ../meshes/structured_3x3x3/bottom.vset
END

GEOMECHANICS_CONDITION south_geomech
  TYPE
    DISPLACEMENT_Y DIRICHLET
  END
    DISPLACEMENT_Y 0.0
END

GEOMECHANICS_CONDITION north_geomech
  TYPE
    RIGID_PLATE_Y NEUMANN
  END
  RIGID_PLATE_FORCE_Y LIST
    TIME_UNITS s
    0.0 0.d0
    1.d-3 -250.d0
  /
END

GEOMECHANICS_CONDITION bottom_geomech
  TYPE
    DISPLACEMENT_Z DIRICHLET
  END
    DISPLACEMENT_Z 0.0
END

GEOMECHANICS_CONDITION west_geomech
  TYPE
    DISPLACEMENT_X DIRICHLET
  END
    DISPLACEMENT_X 0.0
END

GEOMECHANICS_CONDITION east_geomech
  TYPE
    DISPLACEMENT_X DIRICHLET
  END
    DISPLACEMENT_X 0.0
END

GEOMECHANICS_BOUNDARY_CONDITION bottom_geomech
  GEOMECHANICS_CONDITION bottom_geomech
  GEOMECHANICS_REGION bottom_geomech
END

GEOMECHANICS_BOUNDARY_CONDITION north_geomech
  GEOMECHANICS_CONDITION north_geomech
  GEOMECHANICS_REGION north_geomech
END

GEOMECHANICS_BOUNDARY_CONDITION south_geomech
  GEOMECHANICS_CONDITION south_geomech
  GEOMECHANICS_REGION south_geomech
END

GEOMECHANICS_BOUNDARY_CONDITION west_geomech
  GEOMECHANICS_CONDITION west_geomech
  GEOMECHANICS_REGION west_geomech
END

GEOMECHANICS_BOUNDARY_CONDITION east_geomech
  GEOMECHANICS_CONDITION east_geomech
  GEOMECHANICS_REGION east_geomech
END

GEOMECHANICS_STRATA
  GEOMECHANICS_REGION all_geomech
  GEOMECHANICS_MATERIAL soil1
END

GEOMECHANICS_MATERIAL_PROPERTY soil1
  ID 1
  ROCK_DENSITY 1000.0
  YOUNGS_MODULUS 100.d3
  POISSONS_RATIO 0.25
  BIOT_COEFFICIENT 1.0
  THERMAL_EXPANSION_COEFFICIENT 0.d0
END

GEOMECHANICS_REGRESSION
  VERTICES
    8
    33
    58
    83
    108
  /
  VARIABLES
    DISPLACEMENT_Z
  /
END

END_GEOMECHANICS
