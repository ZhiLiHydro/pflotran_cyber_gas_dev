!==============================================================================
! Time — initial 5y test run matching pflotran_HDP_3.in benchmark
!==============================================================================
TIME
  FINAL_TIME 300.d0 y
  MAXIMUM_TIMESTEP_SIZE 10.d0 y
END

!==============================================================================
! Output
!==============================================================================
OUTPUT
  TIME_UNITS y
!  MASS_BALANCE_FILE
!    PERIODIC TIMESTEP 1
!  /
  VELOCITY_AT_CENTER
  VARIABLES
    LIQUID_PRESSURE
    PERMEABILITY

    POROSITY
  /
END

END_SUBSURFACE
