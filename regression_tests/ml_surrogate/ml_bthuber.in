    ! Plutonic rock mineralogy (Σ VF = 0.992 → φ = 0.008)
    Quartz_Inert    0.0     10.0
    K-Feldspar      0.2845  10.0
    Albite          0.1241  10.0
    Anorthite       0.1176  10.0
    Quartz          0.3041  10.0
    Muscovite       0.0551  10.0
    Phlogopite      0.0745  10.0
    Calcite         0.0100  2.710d5
    Illite          0.0179  10.0
    ! Cement-derived secondary phases: zero VF
    CSH165          1.e-8   0.5527d0
    CSH115          1.e-8   1.3282d0
    CSH075          1.e-8   1.8789d0
    CSH065          1.e-8   2.0066d0
    CSH055          1.e-8   2.1307d0
    Portlandite     0       10.44
    Analcime        0       0.d0   ! QPAC Rock=0
    Brucite         0       0.d0   ! QPAC Rock=0
    C4AH19          1.e-8   0.1802d0
    Dolomite        0       10.0
    Ettringite-Al   0       0.d0   ! QPAC Rock=0
    Friedel-Salt    0       0.d0   ! QPAC Rock=0 (family)
    Gypsum          0       10.0
    Hydrotalcite-M4Ac 0     0.d0   ! QPAC Rock=0
    Katoite-Al      1.e-8   0.2522d0
    Monocarbonate-Al 0      0.d0   ! QPAC Rock=0 (family)
    Monosulfate-Al  0       0.d0   ! QPAC Rock=0
    Pyrophyllite    0       10.0
    Sepiolite       0       10.0
    Stratlingite-Al 0       0.d0   ! QPAC Rock=0
    Kaolinite       0       10.0
    Montmor-Na      0       10.0
    ! Outside March-2026 reduction — masked everywhere (SSA=0)
    CSH155          1.e-8   0.7140d0
    CSH145          1.e-8   0.8726d0
    CSH135          1.e-8   1.0285d0
    CSH125          1.e-8   1.1804d0
    CSH105          1.e-8   1.4712d0
    CSH095          1.e-8   1.6100d0
    CSH085          1.e-8   1.7470d0
    C4AH13          1.e-8   0.2046d0
    Hydrotalcite-M4A  0  0.d0
    Hydrotalcite-M6A  0  0.d0
    Hydrotalcite-M6Ac 0  0.d0
    Katoite-AlSi040 1.e-8   0.2644d0
    Katoite-AlSi080 1.e-8   0.2772d0
  /
END

CONSTRAINT fracture_ic
  ACKNOWLEDGE_ZERO_SURFACE_AREA   ! masked minerals (VF=0, SSA=0) are intentional
  CONCENTRATIONS
    Na+         3.1d-3    T
    Ca++        4.0d-4    T
    K+          1.6d-5    T
    Al+++       7.9d-7    T
    Mg++        8.2d-6    T
    H+          8.16d0    pH
    HCO3-       9.5d-4    T
    Cl-         2.3d-3    T
    SO4--       7.3d-6    T
    H4SiO4(aq)  3.2d-4    T
    H2O         55.5      T
    Tracer      1.d-20    T
  /
  MINERALS
    !--------------------------------------------------------------------------
    ! QPAC FRACTURE MASK (v5): active set = QPAC-18 ∩ March-2026 reduction.
    ! Active minerals: 1e-8 VF seed, A0 = SSA_QPAC[m2/g] * rho[g/m3] * VF0
    !   (so area = A0*(VF/VF0)^1 reproduces QPAC's linear area slope):
    !   CSH165: 22.43 m2/g * 2.464e6 g/m3 * 1e-8 = 0.553 m2/m3
    !   CSH115: 55.81 * 2.380e6 * 1e-8 = 1.328     CSH075: 82.51*2.277e6*1e-8 = 1.879
    !   C4AH19: 10 * 1.802e6 * 1e-8 = 0.180        Katoite-Al: 10*2.522e6*1e-8 = 0.252
    !   Calcite (VF0=0.005): 10 * 2.710e6 * 0.005 = 1.355e5 -> use 1.355d5
    ! Masked minerals: VF=0, SSA=0 -> zero area forever (QPAC Rate=0 analogue);
    ! still in output for SI diagnostics.
    !--------------------------------------------------------------------------
    ! Fracture: nearly open (Σ VF = 0.010 -> φ = 0.990)
    Quartz_Inert    0.005   1.3d5
    Calcite         0.005   1.355d5
    ! -- active seeds: FULL QPAC-18 fracture set --
    ! A0 = SSA_QPAC[m2/g] * rho[g/m3] * VF0(=1e-8); rho = MW/Vm from database
    CSH165          1.e-8   0.5527d0
    CSH155          1.e-8   0.7140d0
    CSH145          1.e-8   0.8726d0
    CSH135          1.e-8   1.0285d0
    CSH125          1.e-8   1.1804d0
    CSH115          1.e-8   1.3282d0
    CSH105          1.e-8   1.4712d0
    CSH095          1.e-8   1.6100d0
    CSH085          1.e-8   1.7470d0
    CSH075          1.e-8   1.8789d0
    CSH065          1.e-8   2.0066d0
    CSH055          1.e-8   2.1307d0
    C4AH13          1.e-8   0.2046d0
    C4AH19          1.e-8   0.1802d0
    Katoite-Al      1.e-8   0.2522d0
    Katoite-AlSi040 1.e-8   0.2644d0
    Katoite-AlSi080 1.e-8   0.2772d0
    ! -- masked: QPAC Rate_Mineral[*,Fracture] = 0 --
    Portlandite     0.d0    0.d0
    Analcime        0.d0    0.d0
    Brucite         0.d0    0.d0
    Dolomite        0.d0    0.d0
    Ettringite-Al   0.d0    0.d0
    Friedel-Salt    0.d0    0.d0
    Gypsum          0.d0    0.d0
    Hydrotalcite-M4Ac 1.e-8  0.2015d0   ! UNMASKED (QPAC-figure test)
    K-Feldspar      0.d0    0.d0
    Monocarbonate-Al 0.d0   0.d0
    Monosulfate-Al  0.d0    0.d0
    Pyrophyllite    0.d0    0.d0
    Quartz          0.d0    0.d0
    Sepiolite       0.d0    0.d0
    Stratlingite-Al 0.d0    0.d0
    Albite          0.d0    0.d0
    Anorthite       0.d0    0.d0
    Muscovite       0.d0    0.d0
    Phlogopite      0.d0    0.d0
    Illite          0.d0    0.d0
    Kaolinite       0.d0    0.d0
    Montmor-Na      0.d0    0.d0
    ! -- masked: QPAC Rate=0 in Fracture (hydrotalcite family) --
    Hydrotalcite-M4A  0.d0  0.d0
    Hydrotalcite-M6A  0.d0  0.d0
    Hydrotalcite-M6Ac 0.d0  0.d0
  /
END

