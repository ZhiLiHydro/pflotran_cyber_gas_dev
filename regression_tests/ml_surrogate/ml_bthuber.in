MINERAL_KINETICS

  Quartz_Inert
    RATE_CONSTANT 1.d-30
  /

  !-- Cement primary phases --------------------------------------------------
  Portlandite
    RATE_CONSTANT -6.0  ! -7.0
    SURFACE_AREA_FUNCTION VOLUME_FRACTION_RATIO
    SURFACE_AREA_VOL_FRAC_POWER 1.0d0
  /

  CSH165
    RATE_CONSTANT -8.47   ! QPAC K_PRIMED 10^-8.47
    SURFACE_AREA_FUNCTION VOLUME_FRACTION_RATIO
    SURFACE_AREA_VOL_FRAC_POWER 1.0d0
  /
  CSH115
    RATE_CONSTANT -10.67  ! QPAC K_PRIMED (was -10.66)
    SURFACE_AREA_FUNCTION VOLUME_FRACTION_RATIO
    SURFACE_AREA_VOL_FRAC_POWER 1.0d0
  /
  CSH075
    RATE_CONSTANT -10.87
    SURFACE_AREA_FUNCTION VOLUME_FRACTION_RATIO
    SURFACE_AREA_VOL_FRAC_POWER 1.0d0
  /

  Brucite
    RATE_CONSTANT -8.24
    SURFACE_AREA_FUNCTION VOLUME_FRACTION_RATIO
    SURFACE_AREA_VOL_FRAC_POWER 1.0d0
  /
  C4AH19
    RATE_CONSTANT -10.94
