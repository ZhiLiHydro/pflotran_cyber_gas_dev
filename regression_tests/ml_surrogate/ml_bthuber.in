REGION all
  COORDINATES
    2.5d0     0.0d0  -1.0d0
    10.8652d0  1.0d0   1.336980688e-05
  /
END

REGION cement
  ! QPAC liner: R in [2.50, 2.55], full Z column (LinerInner_R -> LinerOuter_R)
  COORDINATES
    2.50d0    0.0d0  -1.0d0
    2.55d0    1.0d0   1.336980688e-05
  /
END

REGION cement_west_face
  ! tunnel-side liner face — the new system inlet
  FACE WEST
  COORDINATES
    2.50d0  0.0d0  -1.0d0
    2.50d0  1.0d0   1.336980688e-05
  /
END

REGION rock
  COORDINATES
    2.55d0    0.0d0  -1.0d0
    10.8652d0  1.0d0   0.0d0
  /
END

REGION fracture
  COORDINATES
    2.55d0    0.0d0  0.0d0
    10.8652d0  1.0d0  1.336980688e-05
  /
END

REGION inlet_fracture_face
  FACE WEST
  COORDINATES
    2.55d0  0.0d0  0.0d0
    2.55d0  1.0d0   1.336980688e-05
  /
END

REGION outlet_far_face
  ! v5.3: fracture-only, matching QPAC (rock east face sealed)
  FACE EAST
  COORDINATES
    10.8652d0  0.0d0   0.0d0
    10.8652d0  1.0d0   1.336980688e-05
  /
END

REGION obs_frac_inlet
  COORDINATE 2.6d0 0.5d0 6.684903441e-06
END
REGION obs_frac_mid
  COORDINATE 6.5d0 0.5d0 6.684903441e-06
END
REGION obs_frac_outlet
  COORDINATE 10.8d0 0.5d0 6.684903441e-06
END

!==============================================================================
! Material properties
!==============================================================================
MATERIAL_PROPERTY cement
  ID 4
  POROSITY 0.1d0                      ! QPAC Chem::InitialPorosity = 0.1
  CHARACTERISTIC_CURVES cc1
  PERMEABILITY
    PERM_ISO 1.02d-12                 ! QPAC K[Cement] = 1e-5 m/s hydraulic
  /
  PERMEABILITY_CRITICAL_POROSITY 0.001d0
  PERMEABILITY_POWER 3.0d0
  PERMEABILITY_MIN_SCALE_FACTOR 1.d-5
END

MATERIAL_PROPERTY rock
  ID 2
  POROSITY 0.008d0
  !TORTUOSITY 2.82d-4
  CHARACTERISTIC_CURVES cc1
  PERMEABILITY
    PERM_ISO 1.02d-19
  /
END

MATERIAL_PROPERTY fracture
  ID 3
  POROSITY 0.99d0
  TORTUOSITY_FUNCTION_OF_POROSITY 3.05d0
  CHARACTERISTIC_CURVES cc1
  PERMEABILITY
    PERM_ISO 5.958391201e-11
  /
  PERMEABILITY_CRITICAL_POROSITY 0.001d0
  PERMEABILITY_POWER 3.0d0
  PERMEABILITY_MIN_SCALE_FACTOR 1.d-8   ! v5.3: was 1e-5 -> 27% flux leak through a sealed cell; 1e-8 -> 0.03%. Safe under DIRICHLET head (no force-feed blowup)
END

!==============================================================================
! Characteristic curves
!==============================================================================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    LIQUID_RESIDUAL_SATURATION 0.1d0
    M 0.8d0
    ALPHA 1.d-4
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    LIQUID_RESIDUAL_SATURATION 0.1d0
    M 0.8d0
  /
END

!==============================================================================
! Flow conditions
!==============================================================================
FLOW_CONDITION initial_head
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
  /
  DATUM 0.d0 0.d0 0.d0
  LIQUID_PRESSURE 1.013d5
END

! Superseded for this deck: Neumann fixed-flux (the sweep deck's BC) force-feeds
! a clogging system -> inlet pressure diverges (Richards SNES_DIVERGED_DTOL).
! FLOW_CONDITION inlet_pressure
!   TYPE
!     LIQUID_FLUX NEUMANN
!   /
!   LIQUID_FLUX 1.0d-6
! END

FLOW_CONDITION inlet_head
  ! QPAC FracLinerInner_BC translation: SpecifiedHead (Dirichlet), head
  ! back-computed to deliver fr through the INITIAL conductivity, then left
  ! fixed -> delivered flux SELF-LIMITS as the system clogs (K = ap*phi/4
  ! falls with porosity; QPAC NUMO_PR_model1.in line 79).
  !   H  = fr/K0 * (RockThickness+LinerThickness)/2
  !      = (1.0e-6 / 2.5e-5) * (8.3152+0.05)/2  =  0.167 m
  !   P  = 1.013e5 + rho*g*H = 1.013e5 + 1.64e3  =  1.0294e5 Pa
  ! fr = 1.0e-6 m/s from v3 deck provenance (params.inc not available —
  ! VERIFY: initial Darcy flux at the liner face should be ~1e-6 m/s; if not,
  ! scale the pressure offset linearly in fr.
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 1.0294d5
END

FLOW_CONDITION outlet_pressure
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 1.013d5
END

!==============================================================================
! Transport conditions
!==============================================================================
TRANSPORT_CONDITION tc_cement_init
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0  cement_ic
  /
END

TRANSPORT_CONDITION tc_rock_init
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0  rock_ic
  /
END

TRANSPORT_CONDITION tc_fracture_init
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0  fracture_ic
  /
END

! VARIANT: step change RegI → RegIII at WATER_CHANGE_TIME = 5000 y
TRANSPORT_CONDITION tc_inlet_VARIANT
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0     cement_water_RegI
    5000.d0 y cement_water_RegIII
  /
END

! RegI only (constant) — for Dakota sweep
TRANSPORT_CONDITION tc_inlet_RegI
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0  cement_water_RegI
  /
END

! RegIII only (constant) — for Dakota sweep
TRANSPORT_CONDITION tc_inlet_RegIII
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0  cement_water_RegIII
  /
END

TRANSPORT_CONDITION tc_outlet
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0  groundwater
  /
END

!==============================================================================
! Initial & boundary conditions
!==============================================================================
INITIAL_CONDITION
  FLOW_CONDITION initial_head
  TRANSPORT_CONDITION tc_cement_init
  REGION cement
END

INITIAL_CONDITION
  FLOW_CONDITION initial_head
  TRANSPORT_CONDITION tc_rock_init
  REGION rock
END

INITIAL_CONDITION
  FLOW_CONDITION initial_head
  TRANSPORT_CONDITION tc_fracture_init
  REGION fracture
END

BOUNDARY_CONDITION inlet_bc
  ! moved from inlet_fracture_face (x=2.55, now internal) to the tunnel-side
  ! liner face. Tunnel water (RegI) enters the PASTE and is re-buffered before
  ! reaching the fracture — chemistry at the fracture now EMERGES from the paste.
  FLOW_CONDITION inlet_head          ! QPAC-faithful head BC (self-limiting)
  TRANSPORT_CONDITION tc_inlet_RegI
  REGION cement_west_face
END

BOUNDARY_CONDITION outlet_bc
  FLOW_CONDITION outlet_pressure
  TRANSPORT_CONDITION tc_outlet
  REGION outlet_far_face
END

!==============================================================================
! Strata
!==============================================================================
STRATA
  REGION cement
  MATERIAL cement
END

STRATA
  REGION rock
  MATERIAL rock
END

STRATA
  REGION fracture
  MATERIAL fracture
END

!==============================================================================
! Observation points
!==============================================================================

!==============================================================================
! Constraints
!------------------------------------------------------------------------------
! SSA values (m²/m³) taken directly from pflotran_HDP_3.in.
! Zero VF for all non-present minerals: PFLOTRAN handles nucleation via SSA.
! Quartz_Inert closes the porosity budget as inert solid matrix.
!
! Porosity check:
!   cement:  Σ VF = 0.870 → φ = 0.130 ✓  (matches MATERIAL_PROPERTY 0.13)
!   rock:    Σ VF = 0.992 → φ = 0.008 ✓
!   fracture: Σ VF = 0.010 → φ = 0.990 ✓
!==============================================================================


CONSTRAINT cement_ic
  ! QPAC cement paste inventory (Chemistry.inc lines 143-148, VF = X*1e-2):
  !   Portlandite 0.049, CSH165 0.092, Monosulfate-Al 0.019,
  !   Katoite-AlSi080 0.015, Hydrotalcite-M6A 0.007, Calcite 0.001  (sum 0.183)
  ! porosity 0.1 (QPAC) => inert aggregate = 1 - 0.1 - 0.183 = 0.717
  ! A0 = SSA_QPAC[m2/g] * rho[g/m3] * VF ; seeds (1e-8) for all potential
  ! secondaries — QPAC's Cement material has the FULL mineral set active.
  ! Pore water = RegI (paste-equilibrated); expect a brief re-equilibration
  ! transient at t=0.
  CONCENTRATIONS
    Na+         1.97d-1      T
    Ca++        4.44d-3      T
    K+          2.26d-1      T
    Al+++       1.82d-5      T
    Mg++        4.39d-7      T
    H+          12.36d0      pH
    HCO3-       4.94d-5      T
    Cl-         2.26d-3      T
    SO4--       1.43d-1      T
    H4SiO4(aq)  3.07d-5      T
    H2O         55.5         T
    Tracer      1.d-20       T
  /
  MINERALS
    ! -- present phases (QPAC inventory) --
    Quartz_Inert    0.717   1.0d5      ! inert aggregate filler
    Portlandite     0.049   1.147d6    ! 10.44 m2/g * 2.2415 g/cc
    CSH165          0.092   5.085d6    ! 22.43 * 2.4643
    Monosulfate-Al  0.019   3.827d5    ! 10 * 2.0144
    Katoite-AlSi080 0.015   4.158d5    ! 10 * 2.7720
    Hydrotalcite-M6A 0.007  2.185d5    ! 11.94 * 2.6140
    Calcite         0.001   2.710d4    ! 10 * 2.7103
    ! -- potential secondaries: seeded (all active in QPAC cement) --
    CSH155          1.e-8   0.7140d0
    CSH145          1.e-8   0.8726d0
    CSH135          1.e-8   1.0285d0
    CSH125          1.e-8   1.1804d0
    CSH115          1.e-8   1.3282d0
    CSH105          1.e-8   1.4712d0
    CSH095          1.e-8   1.6100d0
    CSH085          1.e-8   1.7470d0
    CSH075          1.e-8   1.8789d0
    CSH065          1.e-8   2.0066d0
    CSH055          1.e-8   2.1307d0
    C4AH13          1.e-8   0.2046d0
    C4AH19          1.e-8   0.1802d0
    Katoite-Al      1.e-8   0.2522d0
    Katoite-AlSi040 1.e-8   0.2644d0
    Ettringite-Al   1.e-8   0.25d0     ! ~10 m2/g * ~2.5 g/cc generic seed A0
    Stratlingite-Al 1.e-8   0.25d0
    Monocarbonate-Al 1.e-8  0.25d0
    Friedel-Salt    1.e-8   0.25d0
    Gypsum          1.e-8   0.25d0
    Hydrotalcite-M4A  1.e-8 0.25d0
    Hydrotalcite-M4Ac 1.e-8 0.25d0
    Hydrotalcite-M6Ac 1.e-8 0.25d0
    Brucite         1.e-8   0.25d0
    Dolomite        1.e-8   0.25d0
    Analcime        1.e-8   0.25d0
    Sepiolite       1.e-8   0.25d0
    Pyrophyllite    1.e-8   0.25d0
    Quartz          1.e-8   0.25d0
    K-Feldspar      1.e-8   0.25d0
    Albite          1.e-8   0.25d0     ! dissolve-only (precip -30) => stays at seed
    Anorthite       1.e-8   0.25d0
    Muscovite       1.e-8   0.25d0
    Phlogopite      1.e-8   0.25d0
    Illite          1.e-8   0.25d0
    Kaolinite       1.e-8   0.25d0
    Montmor-Na      1.e-8   0.25d0
  /
END

CONSTRAINT rock_ic
  ACKNOWLEDGE_ZERO_SURFACE_AREA   ! masked minerals (VF=0, SSA=0) are intentional
  CONCENTRATIONS
    Na+         3.1d-3    T
    Ca++        4.0d-4    T
    K+          1.6d-5    T
    Al+++       7.9d-7    T
    Mg++        8.2d-6    T
