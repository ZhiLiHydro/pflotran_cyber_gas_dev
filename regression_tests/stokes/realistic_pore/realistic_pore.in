!------------------------------------------------------------------------------
! Time stepping
!   Pressure gradient 4.0 Pa over 2.0 m => mean u ≈ 0.17 m/s (open channel)
!   Pore-network resistance ~2x open channel; u_pore ≈ 0.1 m/s
!   Run to t = 20 s so tracer front fully traverses the domain.
!   Output every 0.2 s => 100 VTK snapshots.
!------------------------------------------------------------------------------

TIME
  FINAL_TIME            20.d0 s
  INITIAL_TIMESTEP_SIZE 1.d-3 s
  MAXIMUM_TIMESTEP_SIZE 2.d-1 s
END

!------------------------------------------------------------------------------
! Output
!------------------------------------------------------------------------------

OUTPUT
  FORMAT VTK
  VARIABLES
    LIQUID_PRESSURE
    STOKES_VELOCITY_X
    STOKES_VELOCITY_Y
    STOKES_VELOCITY_Z
    MATERIAL_ID
  /
  PERIODIC TIME 2.d-1 s
/

END_SUBSURFACE
