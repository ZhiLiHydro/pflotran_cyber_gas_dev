!==============================================================================
! Pore-scale Stokes flow + GIRT tracer transport (pressure-gradient driven).
! Randomly packed circular grains, RSA seed=7, 24 grains.
! Grid: 80x40x1, domain 2.0x1.0x0.1 m, dx=dy=0.025 m
! Inlet (west): p = 4.0 Pa;  Outlet (east): p = 0 Pa
!==============================================================================

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE STOKES
      OPTIONS
        DENSITY   1.d0
        VISCOSITY 1.d0
        ADD_CONVECTION
      /
    /
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
      OPTIONS
        REFERENCE_TEMPERATURE 25.d0
      /
    /
  /
END

SUBSURFACE

!------------------------------------------------------------------------------
! Numerical methods
!------------------------------------------------------------------------------

NUMERICAL_METHODS FLOW
  NEWTON_SOLVER
    RESIDUAL_SCALED_INF_TOL 1.d-2
    ITOL        1.d-8
    ITOL_UPDATE 1.d-2
    RTOL        1.d-8
  /
/

NUMERICAL_METHODS TRANSPORT
  NEWTON_SOLVER
    ITOL        1.d-8
    ITOL_UPDATE 1.d-2
    RTOL        1.d-8
  /
/

!------------------------------------------------------------------------------
! Grid: 80 x 40 x 1, dx = dy = 0.0250 m
!------------------------------------------------------------------------------

GRID
  TYPE structured
  ORIGIN 0.d0 0.d0 0.d0
  BOUNDS
    0.d0 0.d0 0.d0
    2.0d0 1.0d0 0.1d0
  /
  NXYZ 80 40 1
END

!------------------------------------------------------------------------------
! Material
!------------------------------------------------------------------------------

MATERIAL_PROPERTY pore_fluid
  ID 1
  POROSITY 1.0
  TORTUOSITY 1.0
  PERMEABILITY
    PERM_ISO 1.d0
  /
END

!------------------------------------------------------------------------------
! Fluid / chemistry
!------------------------------------------------------------------------------

FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 5.d-3
END

CHEMISTRY
  PRIMARY_SPECIES
    Tracer
  END
  OUTPUT
    TOTAL
    Tracer
  /
END

!------------------------------------------------------------------------------
! Regions
!------------------------------------------------------------------------------

REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    2.0d0 1.0d0 0.1d0
  /
END

