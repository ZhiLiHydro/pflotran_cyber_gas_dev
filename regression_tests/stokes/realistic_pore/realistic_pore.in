! ---- Boundary face regions ----
REGION inlet
  FACE WEST
  COORDINATES
    0.d0 0.0d0 0.d0
    0.d0 1.0d0 0.1d0
  /
END

REGION right
  FACE EAST
  COORDINATES
    2.0d0 0.d0 0.d0
    2.0d0 1.0d0 0.1d0
  /
END

REGION bottom
  FACE SOUTH
  COORDINATES
    0.d0 0.d0 0.d0
    2.0d0 0.d0 0.1d0
  /
END

REGION top
  FACE NORTH
  COORDINATES
    0.d0 1.0d0 0.d0
    2.0d0 1.0d0 0.1d0
  /
END

!------------------------------------------------------------------------------
! Flow conditions
!------------------------------------------------------------------------------

FLOW_CONDITION inflow
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 4.0d0
END

FLOW_CONDITION outflow
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 0.d0
END

FLOW_CONDITION no_slip
  TYPE
    VELOCITY DIRICHLET
  /
  VELOCITY 0.d0 0.d0 0.d0
END

!------------------------------------------------------------------------------
! Transport conditions
!------------------------------------------------------------------------------

TRANSPORT_CONDITION background
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT background
    CONCENTRATIONS
      Tracer 1.d-10 F
    /
  /
END

! Standalone constraints for the inlet pulse (t < 2 s: tracer on; t >= 2 s: off)
CONSTRAINT tracer_on
  CONCENTRATIONS
    Tracer 1.d0 F
  /
/

CONSTRAINT tracer_off
  CONCENTRATIONS
    Tracer 1.d-10 F
  /
/

! 2-second tracer pulse on the full west inlet face
TRANSPORT_CONDITION tracer_pulse
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0  tracer_on
    2.d0  tracer_off
  /
END

!------------------------------------------------------------------------------
! Initial and boundary / prescribed conditions
!------------------------------------------------------------------------------

INITIAL_CONDITION initial
  FLOW_CONDITION      inflow
  TRANSPORT_CONDITION background
  REGION all
END

! West: pressure inlet -- tracer pulse (0-2 s) on entire west face
PRESCRIBED_CONDITION inlet
  FLOW_CONDITION      inflow
  TRANSPORT_CONDITION tracer_pulse
  REGION inlet
END

! East: pressure outlet
PRESCRIBED_CONDITION outlet
  FLOW_CONDITION      outflow
  TRANSPORT_CONDITION background
  REGION right
END

! No-slip walls
PRESCRIBED_CONDITION bottom_wall
  FLOW_CONDITION      no_slip
  TRANSPORT_CONDITION background
  REGION bottom
END

PRESCRIBED_CONDITION top_wall
  FLOW_CONDITION      no_slip
  TRANSPORT_CONDITION background
  REGION top
END

