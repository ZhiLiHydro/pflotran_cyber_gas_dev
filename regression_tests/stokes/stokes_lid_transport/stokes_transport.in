SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE STOKES
      OPTIONS
        DENSITY 1.d0
        VISCOSITY 10000.d0
        ADD_CONVECTION
      /
    /
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
      OPTIONS
        REFERENCE_TEMPERATURE 25.d0
      /
    /
  /
END

EXTERNAL_FILE stokes_lid_transport_common.txt
