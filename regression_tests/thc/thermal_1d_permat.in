#Description: 1D thermal advection with solid thermal properties from
#             MATERIAL_PROPERTY.
#             soil1 uses a DEFAULT thermal characteristic curve, soil2 a POWER
#             curve -- the only path supplying d(kappa_eff)/dT.  The two input
#             styles cannot be mixed in one deck (realization_subsurface.F90).

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE THC
      OPTIONS
        SPECIFIC_HEAT_LIQUID 4184.d0 J/kg-C
      /
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW

  NEWTON_SOLVER
    MAX_ALLOW_LIQ_PRES_CHANGE_NI 1.d0
  /

  LINEAR_SOLVER
    SOLVER DIRECT
  /

END

#=========================== regression =======================================
REGRESSION
  CELLS_PER_PROCESS 5
END

#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 100 1 1
  BOUNDS
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

#=========================== fluid properties =================================
# DIFFUSION_ACTIVATION_ENERGY turns on the Arrhenius scaling of the molecular
# diffusion coefficient; without it the coefficient stays constant.
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
  DIFFUSION_ACTIVATION_ENERGY 15000.d0
END

#=========================== material properties ==============================
# Solid thermal properties live here (TH-style) instead of the mode OPTIONS
# block.  ROCK_DENSITY * SPECIFIC_HEAT supplies rho_s*c_s; the bulk dry/wet
# conductivities supply the effective porous-medium conductivity directly.
MATERIAL_PROPERTY soil1
  ID 1
  POROSITY 0.25d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2650.d0
  SPECIFIC_HEAT 800.d0
  THERMAL_CHARACTERISTIC_CURVES cct_default
  PERMEABILITY
    PERM_ISO 1.d-10
  /
  CHARACTERISTIC_CURVES cc1
END

# identical to soil1 except the conductivity comes from a temperature-dependent
# THERMAL_CHARACTERISTIC_CURVES rather than bulk dry/wet values
MATERIAL_PROPERTY soil2
  ID 2
  POROSITY 0.25d0
  TORTUOSITY 1.d0
  ROCK_DENSITY 2650.d0
  SPECIFIC_HEAT 800.d0
  THERMAL_CHARACTERISTIC_CURVES cct_power
  PERMEABILITY
    PERM_ISO 1.d-10
  /
  CHARACTERISTIC_CURVES cc1
END

#=========================== thermal characteristic curves ====================
# DEFAULT reproduces the bulk dry/wet interpolation exactly (d(kappa)/dT = 0)
THERMAL_CHARACTERISTIC_CURVES cct_default
  THERMAL_CONDUCTIVITY_FUNCTION DEFAULT
    THERMAL_CONDUCTIVITY_DRY 2.0062209149293d0 W/m-C
    THERMAL_CONDUCTIVITY_WET 2.0062209149293d0 W/m-C
  /
/

THERMAL_CHARACTERISTIC_CURVES cct_power
  THERMAL_CONDUCTIVITY_FUNCTION POWER
    THERMAL_CONDUCTIVITY_DRY 2.0062209149293d0 W/m-C
    THERMAL_CONDUCTIVITY_WET 2.0062209149293d0 W/m-C
    EXPONENT -1.18d0
  /
/

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    ALPHA 1.d-4
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
END

#=========================== output options ===================================
OUTPUT
  TIMES d 1.0 2.0 3.0
  FORMAT TECPLOT POINT
  VARIABLES
    LIQUID_PRESSURE
    TEMPERATURE
    LIQUID_DENSITY
    LIQUID_VISCOSITY
    SOLUTE_CONCENTRATION
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 4.d0 d
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 2.d0 h
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

REGION upstream_half
  COORDINATES
    0.d0 0.d0 0.d0
    5.d0 1.d0 1.d0
  /
END

REGION downstream_half
  COORDINATES
    5.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

REGION west
  FACE WEST
  COORDINATES
    0.d0 0.d0 0.d0
    0.d0 1.d0 1.d0
  /
END

REGION east
  FACE EAST
  COORDINATES
    10.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

#=========================== flow conditions ==================================
# Initially cold, saturated column at uniform pressure
FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE DIRICHLET
    TEMPERATURE DIRICHLET
    CONCENTRATION DIRICHLET
  /
  LIQUID_PRESSURE 101325.d0
  TEMPERATURE 20.d0
  CONCENTRATION 0.d0
END

# Hot water injected at the inlet at a fixed Darcy flux
FLOW_CONDITION inlet
  TYPE
    LIQUID_FLUX NEUMANN
    TEMPERATURE DIRICHLET
    CONCENTRATION DIRICHLET
  /
  LIQUID_FLUX 1.d0 m/d
  TEMPERATURE 80.d0
  CONCENTRATION 1.d-3
END

# Outlet pressure held; outgoing temperature/concentration advected out
FLOW_CONDITION outlet
  TYPE
    LIQUID_PRESSURE DIRICHLET
    TEMPERATURE ZERO_GRADIENT
    CONCENTRATION ZERO_GRADIENT
  /
  LIQUID_PRESSURE 101325.d0
  TEMPERATURE 20.d0
  CONCENTRATION 0.d0
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial
  REGION all
END

BOUNDARY_CONDITION inlet
  FLOW_CONDITION inlet
  REGION west
END

BOUNDARY_CONDITION outlet
  FLOW_CONDITION outlet
  REGION east
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION upstream_half
  MATERIAL soil1
END

STRATA
  REGION downstream_half
  MATERIAL soil2
END


END_SUBSURFACE
