#Description: 3D groundwater flow and solute transport

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
    /
  /
  CHECKPOINT
    PERIODIC TIMESTEP 50
    PERIODIC TIME 2 yr
  /
  #RESTART regional_doublet-restart.chk RESET_TO_TIME_ZERO
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW

  NEWTON_SOLVER
    ITOL_UPDATE 1.d0     ! Convergences with max change in pressure is 1 Pa.
  /

END

#=========================== chemistry ========================================
CHEMISTRY
...
END

#=========================== discretization ===================================
GRID
...
END

#=========================== fluid properties =================================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.d-9
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil1
  ID 1
  POROSITY ...
  TORTUOSITY ...
  CHARACTERISTIC_CURVES cc1
  PERMEABILITY
    ...
  /
END

MATERIAL_PROPERTY soil2
  ID 2
  POROSITY ...
  TORTUOSITY ...
  CHARACTERISTIC_CURVES cc1
  PERMEABILITY
    ...
  /
END

MATERIAL_PROPERTY soil3
  ID 3
  POROSITY ...
  TORTUOSITY ...
  CHARACTERISTIC_CURVES cc1
  PERMEABILITY
    ...
  /
END

MATERIAL_PROPERTY soil4
  ID 4
  POROSITY ...
  TORTUOSITY ...
  CHARACTERISTIC_CURVES cc1
  PERMEABILITY
    ...
  /
END

#=========================== saturation functions =============================
CHARACTERISTIC_CURVES cc1
...
END

#=========================== output options ===================================
OUTPUT
  SNAPSHOT_FILE
    PERIODIC TIME ...
    PERIODIC TIME ...
    FORMAT TECPLOT BLOCK
    FORMAT HDF5
    PRINT_COLUMN_IDS
    VARIABLES
      LIQUID_PRESSURE
      LIQUID_SATURATION
      MATERIAL_ID_KLUDGE_FOR_VISIT
    /
  /
  OBSERVATION_FILE
    ...
  /
  VELOCITY_AT_CENTER
END

#=========================== times ============================================
TIME
  FINAL_TIME ... y
  INITIAL_TIMESTEP_SIZE 1.d-2 d
  MAXIMUM_TIMESTEP_SIZE 0.1 y        ! produces CFL ~<= 1.
END

#=========================== regions ==========================================
REGION all
...
END

REGION layer1
...
END

REGION layer2
...
END

REGION layer3
...
END

REGION layer4
...
END

REGION west
...
END

REGION east
...
END

REGION top
...
END

REGION injection_well
...
END

REGION extraction_well
...
END

REGION Obs_pt_center
  ...
END

REGION Obs_pt_center_lower
  ...
END

REGION Obs_pt_west
  ...
END

REGION Obs_pt_east
  ...
END

REGION Obs_pt_north
  ...
END

REGION Obs_pt_south
  ...
END

#=========================== observation points ===============================
OBSERVATION
... 
END
 
OBSERVATION
...
END
 
OBSERVATION
...
END
 
OBSERVATION
...
END
 
OBSERVATION
...
END
 
OBSERVATION
...
END
 
#=========================== flow conditions ==================================
FLOW_CONDITION initial
...
END

FLOW_CONDITION river
...
END

FLOW_CONDITION recharge
...
END

FLOW_CONDITION injection
...
END

FLOW_CONDITION extraction
...
END

#=========================== transport conditions =============================
TRANSPORT_CONDITION initial
...
END

TRANSPORT_CONDITION west
...
END

TRANSPORT_CONDITION injection
...
END

#=========================== condition couplers ===============================
# initial condition
INITIAL_CONDITION
...
END

# west boundary condition
BOUNDARY_CONDITION west
...
END

# east boundary condition
BOUNDARY_CONDITION east
...
END

# top boundary condition
BOUNDARY_CONDITION top
...
END

# source 
SOURCE_SINK injection_well
...
END

# sink 
SOURCE_SINK extraction_well
...
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION layer1
  MATERIAL soil1
END

STRATA
...
END

STRATA
...
END

STRATA
...
END

END_SUBSURFACE
